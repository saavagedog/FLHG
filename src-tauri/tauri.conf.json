    "allowlist": {
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://26.30.86.1:3551/*", "http://localhost:3551/*", "https://fortnite-api.com/*"]
      },
      "shell": {
        "all": true,
        "execute": true
      },
      "all": true,
      "protocol": {
        "all": true,
        "assetScope": ["*/**"]
      },
      "fs": {
        "all": true,
